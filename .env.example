# Copy this template to .env only on your server. Never commit real values.
PORT=8787
HOST=0.0.0.0
# A random secret of at least 32 characters, for example: openssl rand -hex 32
IRON_ACCESS_TOKEN=
# Required for browser requests: exact HTTPS website origins, separated by commas.
# If frontend and API share a host, enter that public origin here too.
IRON_ALLOWED_ORIGINS=http://localhost:8787
# A persistent, privately mounted directory. Back up iron-data.json regularly.
IRON_DATA_DIR=./data
# Choose gemini (conversations + grounded Google research) or groq.
# Leave blank to auto-select Gemini when GEMINI_API_KEY is set, otherwise Groq.
IRON_AI_PROVIDER=
# Server-only Gemini credentials; never put them in browser code or GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional existing Groq alternative; no grounded Google search in this mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
